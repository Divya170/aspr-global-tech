# Where the Next.js server reaches the NestJS API (server-side rendering + the /api proxy)
API_INTERNAL_URL=http://127.0.0.1:4000

# Public URL of the site (used for SEO metadata, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://asprglobaltech.com

# Shared with the API: lets admin edits clear the website's content cache immediately.
REVALIDATE_SECRET=

# Optional cookieless analytics (Plausible). Set to your domain to enable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

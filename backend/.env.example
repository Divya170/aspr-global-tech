# NestJS API
PORT=4000
# SQLite database file (relative to backend/). Created, migrated and seeded on first boot.
DB_PATH=../database/app.sqlite
# Where uploaded attachments are stored (relative to backend/)
UPLOAD_DIR=../database/uploads
# Origin of the Next.js site (for CORS when not using the /api proxy)
CORS_ORIGIN=http://localhost:3000
# Admin dashboard password + token signing secret — CHANGE BOTH in production
ADMIN_PASSWORD=change-me-aspr
ADMIN_TOKEN_SECRET=replace-with-a-long-random-string
# Trust X-Forwarded-For when behind a reverse proxy (true/false)
TRUST_PROXY=false

# --- Chat assistant (Google Gemini) ---
# Without a key the widget still works and serves knowledge-base fallback replies.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
# How long an anonymous chat transcript is kept before it is deleted.
CHAT_SESSION_TTL_DAYS=30

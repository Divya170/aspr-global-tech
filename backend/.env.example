# NestJS API
PORT=4000
# SQLite database file (relative to backend/). Created, migrated and seeded on first boot.
DB_PATH=../database/app.sqlite
# Where uploaded attachments are stored (relative to backend/)
UPLOAD_DIR=../database/uploads
# Origin of the Next.js site (for CORS when not using the /api proxy)
CORS_ORIGIN=http://localhost:3000
# First admin account, created on first start when there are no staff accounts yet.
# Afterwards, manage people and passwords in the admin (Team / Account).
ADMIN_EMAIL=support@asprglobaltech.com
ADMIN_NAME=ASPR Admin
ADMIN_PASSWORD=change-me-aspr
ADMIN_SESSION_TTL_HOURS=12
# Public URL of the website (links in emails)
SITE_URL=http://localhost:3000

# --- Email (SMTP). Without SMTP_HOST, emails are recorded in the outbox but not sent. ---
# Hostinger mail: smtp.hostinger.com, port 465, your mailbox address and password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ASPR Global Tech <support@asprglobaltech.com>
# Who receives new-lead notifications (comma-separated). Defaults to the company email in Settings.
LEADS_NOTIFY_TO=

# --- Website cache refresh after admin edits (same value in the frontend env) ---
WEB_INTERNAL_URL=http://127.0.0.1:3000
REVALIDATE_SECRET=
# Trust X-Forwarded-For when behind a reverse proxy (true/false)
TRUST_PROXY=false

# --- Chat assistant (Google Gemini) ---
# Without a key the widget still works and serves knowledge-base fallback replies.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
# How long an anonymous chat transcript is kept before it is deleted.
CHAT_SESSION_TTL_DAYS=30

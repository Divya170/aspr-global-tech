# Production settings for server.js (website + API in one process).
# Copy to .env in the repo root on the server and fill in. Never commit the real .env.
# REQUIRED = the app refuses to start in production without it. OPTIONAL = a feature is off without it.

NODE_ENV=production

# --- Website ---
# Port the website listens on (nginx proxies to it). Default 3000.
PORT=3000
# Interface to bind. Keep 127.0.0.1 behind nginx so the app is not reachable directly.
HOST=127.0.0.1
# REQUIRED. Public https URL: SEO metadata, sitemap, robots.txt, links in emails. Fixed at build time: rebuild after changing.
NEXT_PUBLIC_SITE_URL=https://asprglobaltech.com
# Same as above for the API; defaults to NEXT_PUBLIC_SITE_URL when empty.
SITE_URL=

# --- API (private; only the website talks to it) ---
API_PORT=4000
API_HOST=127.0.0.1
# Where the website reaches the API. server.js derives it from API_PORT; set only for a split setup.
API_INTERNAL_URL=

# --- Data: REQUIRED absolute paths OUTSIDE the app folder, so redeploys never touch them ---
DB_PATH=/home/CHANGE-ME/aspr-data/app.sqlite
UPLOAD_DIR=/home/CHANGE-ME/aspr-data/uploads

# --- First admin account (REQUIRED on the very first start; refused if weak) ---
# Only used to create the first super admin when no staff account exists. Afterwards manage
# people and passwords in the admin (Team / Account); changing these later has no effect.
ADMIN_EMAIL=support@asprglobaltech.com
ADMIN_NAME=ASPR Admin
# 12+ characters, not the example default.
ADMIN_PASSWORD=
# How long an admin sign-in lasts (hours).
ADMIN_SESSION_TTL_HOURS=12
# Session cookies are Secure (and named __Host-…) in production. Only set false for local HTTP testing.
COOKIE_SECURE=true

# --- Email (SMTP). OPTIONAL but strongly recommended: without SMTP_HOST, leads are saved and
# shown in the admin but no email is sent. If SMTP_HOST is set, SMTP_USER and SMTP_PASS are REQUIRED. ---
# Gmail: smtp.gmail.com, port 587, SMTP_SECURE=false (STARTTLS), an app password.
# Hostinger mail: smtp.hostinger.com, port 465, SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=465
# true for implicit TLS (port 465); false for STARTTLS (port 587). Defaults to true on 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ASPR Global Tech <support@asprglobaltech.com>
# Who receives new-lead notifications (comma-separated). Defaults to the company email in Settings.
LEADS_NOTIFY_TO=

# --- Website cache refresh after admin edits. server.js generates a per-boot secret if empty. ---
REVALIDATE_SECRET=

# --- Behind nginx: lets rate limits see real visitor IPs, and allows the site origin. ---
TRUST_PROXY=true
CORS_ORIGIN=https://asprglobaltech.com
# Raises every rate limit by this factor (tests only). Leave at 1 in production.
RATE_LIMIT_MULTIPLIER=1

# --- Analytics (OPTIONAL, cookieless Plausible). Set to the site's domain to enable; rebuild after changing. ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# --- Chat assistant (Google Gemini). OPTIONAL: without a key the widget answers from the built-in knowledge base. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
CHAT_SESSION_TTL_DAYS=30

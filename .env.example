# Production settings for server.js (website + API in one process).
# Copy to .env on the server, or enter the same keys as environment variables in hPanel.

# --- Website ---
# Hostinger's Node.js hosting sets PORT itself; on a VPS pick any free port behind nginx.
PORT=3000
# Public URL of the site (SEO metadata, sitemap, robots.txt). Needed at build time too.
NEXT_PUBLIC_SITE_URL=https://asprglobaltech.com

# --- API (private, reached only by the website) ---
API_PORT=4000

# --- Data: keep OUTSIDE the deployed folder so redeploys never overwrite it ---
# Absolute paths, e.g. /home/u123456789/aspr-data/app.sqlite on Hostinger.
DB_PATH=/home/CHANGE-ME/aspr-data/app.sqlite
UPLOAD_DIR=/home/CHANGE-ME/aspr-data/uploads

# --- Admin: the API refuses to start in production with the defaults ---
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_HOURS=12

# Hostinger and nginx sit in front of the app; this makes rate limits see real visitor IPs.
TRUST_PROXY=true
CORS_ORIGIN=https://asprglobaltech.com

# --- Chat assistant (Google Gemini). Optional: without a key the widget serves fallbacks. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
CHAT_SESSION_TTL_DAYS=30

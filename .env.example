# Production settings for server.js (website + API in one process).
# Copy to .env on the server, or enter the same keys as environment variables in hPanel.

# --- Website ---
# Hostinger's Node.js hosting sets PORT itself; on a VPS pick any free port behind nginx.
PORT=3000
# Public URL of the site (SEO metadata, sitemap, robots.txt). Needed at build time too.
NEXT_PUBLIC_SITE_URL=https://asprglobaltech.com

# --- API (private, reached only by the website) ---
API_PORT=4000

# --- Data: keep OUTSIDE the deployed folder so redeploys never overwrite it ---
# Absolute paths, e.g. /home/u123456789/aspr-data/app.sqlite on Hostinger.
DB_PATH=/home/CHANGE-ME/aspr-data/app.sqlite
UPLOAD_DIR=/home/CHANGE-ME/aspr-data/uploads

# --- First admin account (created on first start; the API refuses to start without a strong password) ---
ADMIN_EMAIL=support@asprglobaltech.com
ADMIN_NAME=ASPR Admin
# 12+ characters. Only used to create the first account; change it later in the admin under Account.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=12

# --- Email (SMTP). Hostinger mail: smtp.hostinger.com, port 465, mailbox address + password ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ASPR Global Tech <support@asprglobaltech.com>
# Who receives new-lead notifications (comma-separated). Defaults to the company email in Settings.
LEADS_NOTIFY_TO=

# --- Website cache refresh after admin edits. server.js generates one if empty. ---
REVALIDATE_SECRET=

# --- Analytics (optional, cookieless Plausible). Set to the site's domain to enable. ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# Hostinger and nginx sit in front of the app; this makes rate limits see real visitor IPs.
TRUST_PROXY=true
CORS_ORIGIN=https://asprglobaltech.com

# --- Chat assistant (Google Gemini). Optional: without a key the widget serves fallbacks. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
CHAT_SESSION_TTL_DAYS=30
